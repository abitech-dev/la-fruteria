# Cópialo a secretos/copias.env, llena cada valor y déjalo con chmod 600.
# El depósito es uno compatible con S3, fuera del servidor.
RESTIC_REPOSITORY=s3:https://s3.example.com/fruteria-copias
# Sin esta clave nadie abre las copias, tampoco tú. Guárdala también
# fuera del servidor, en tu gestor de contraseñas.
RESTIC_PASSWORD=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
